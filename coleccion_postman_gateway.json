{
  "info": {
    "name": "Tienda | API Gateway (8180)",
    "description": "CRUD de Productos y Pedidos pasando solo por http://localhost:8180. Los IDs de ejemplos deben coincidir con los devueltos por POST. Modifica productoId si tu producto tiene otro ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8180"
    },
    {
      "key": "productoId",
      "value": "1"
    },
    {
      "key": "pedidoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Estado del gateway",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    },
    {
      "name": "02 - GET Productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "03 - POST Producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecanico\",\n  \"precio\": 120000,\n  \"stock\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Producto creado (201)\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"productoId\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - GET Producto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        }
      }
    },
    {
      "name": "05 - PUT Producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecanico RGB\",\n  \"precio\": 130000,\n  \"stock\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 - POST Pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productoId\": {{productoId}},\n  \"cantidad\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pedido creado (201)\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"pedidoId\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - GET Pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos"
          ]
        }
      }
    },
    {
      "name": "08 - GET Pedido por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos",
            "{{pedidoId}}"
          ]
        }
      }
    },
    {
      "name": "09 - PUT Pedido",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos",
            "{{pedidoId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productoId\": {{productoId}},\n  \"cantidad\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 - DELETE Pedido",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos",
            "{{pedidoId}}"
          ]
        }
      }
    },
    {
      "name": "11 - DELETE Producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        }
      }
    }
  ]
}
